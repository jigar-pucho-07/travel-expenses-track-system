                  "sourceCode": {
                    "code": "export const code = async (inputs) => {\n  const b = typeof inputs.body === 'string' ? JSON.parse(inputs.body) : (inputs.body || {});\n  const values = {};\n  if (b.merchant !== undefined && b.merchant !== null) values.Merchant = b.merchant;\n  if (b.amount !== undefined && b.amount !== null) values.Amount = String(b.amount);\n  if (b.tax !== undefined && b.tax !== null) values.Tax = String(b.tax);\n  if (b.sgst !== undefined && b.sgst !== null) values.SGST = String(b.sgst);\n  if (b.cgst !== undefined && b.cgst !== null) values.CGST = String(b.cgst);\n  if (b.gst !== undefined && b.gst !== null) values.GST = String(b.gst);\n  if (b.gstin !== undefined && b.gstin !== null) values.GSTIN = b.gstin;\n  if (b.invoice_number !== undefined && b.invoice_number !== null) values.Invoice_Number = b.invoice_number;\n  if (b.expense_date !== undefined && b.expense_date !== null) values.Date = b.expense_date;\n  if (b.items !== undefined && b.items !== null) values.Items_JSON = typeof b.items === 'string' ? b.items : JSON.stringify(b.items);\n  return { row_id: inputs.rowId, expense_id: inputs.expenseId, values: values };\n};",
                    "packageJson": "{}"
                  },
