            "sourceCode": {
              "code": "export const code = async (inputs) => {\n  let rows = [];\n  const raw = inputs.tripRows;\n  if (Array.isArray(raw)) { rows = raw; }\n  else if (raw && typeof raw === 'object') {\n    const objVals = Object.values(raw);\n    if (objVals.length > 0 && objVals[0] && typeof objVals[0] === 'object' && (objVals[0] as any).values) { rows = objVals; }\n    else { rows = raw.data || raw.rows || objVals; if (!Array.isArray(rows)) rows = [rows]; }\n  }\n\n  if (rows.length === 0) {\n    const resp = { success: false, found: false, trip_id: inputs.tripId || '', message: 'Trip not found' };\n    return { response_body: JSON.stringify(resp) };\n  }\n\n  const rowNum = rows[0].row || rows[0]['row'] || 0;\n  return { found: true, row_id: rowNum, trip_id: inputs.tripId || '' };\n};",
              "packageJson": "{}"
